# Railway backend
SHIP_HOPPA_ENV=production
SHIP_HOPPA_IMPORTER_TOKEN=replace-with-openssl-rand-hex-32
SHIP_HOPPA_ADMIN_TOKEN=replace-with-openssl-rand-hex-32

# Exact production frontend URL once Vercel has one.
SHIP_HOPPA_ALLOWED_ORIGINS=https://ship-hoppa.vercel.app

# Optional: allow Vercel preview deployments during staging.
SHIP_HOPPA_ALLOWED_ORIGIN_REGEX=https://.*\\.vercel\\.app

# Local/dev persistence bridge. Use Railway Postgres before public production.
SHIP_HOPPA_STORE_SNAPSHOT_ENABLED=1
# SHIP_HOPPA_STORE_SNAPSHOT_PATH=/data/store_snapshot.json

# Provider readiness checks. These can stay empty until the real accounts are connected.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# GOOGLE_CLIENT_ID=
# MICROSOFT_CLIENT_ID=
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# WISE_API_TOKEN=
# OFX_API_KEY=
# DCSA_API_KEY=
# PROJECT44_API_KEY=
# VIZION_API_KEY=
